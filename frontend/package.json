  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "three": "0.150.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11 <12"
  },
